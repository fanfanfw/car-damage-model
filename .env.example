# LLM via ProxyAPI (example). Do NOT commit your real key.
LLM_ENABLED=0
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.proxyapi.ru/openai/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=__PUT_YOUR_KEY_HERE__
LLM_TIMEOUT_S=30

# --- Inpainting (Before/After) ---
# auto | sd | cv
INPAINT_METHOD=auto

# Enable Stable Diffusion inpainting (best quality). If 0 -> OpenCV fallback.
INPAINT_SD_ENABLED=0
INPAINT_SD_MODEL=runwayml/stable-diffusion-inpainting
INPAINT_SD_DEVICE=cuda
INPAINT_SD_DTYPE=fp16
INPAINT_SD_STEPS=25
INPAINT_SD_GUIDANCE=6.5
INPAINT_SD_STRENGTH=0.98
INPAINT_SD_NEGATIVE=damage, dent, scratch, crack, broken, rust, text, watermark, label, box, annotation

# --- Streamlit server-side FastAPI client ---
CAR_DAMAGE_API_URL=http://127.0.0.1:18000
# Managed key issued by apikeymanagement with scope car-damage:assess.
# Never expose this value in browser code or commit it.
CAR_DAMAGE_API_KEY=
CAR_DAMAGE_API_TIMEOUT_SECONDS=60

# --- Kong authentication ---
# ENVIRONMENT must be "production" or "development".
ENVIRONMENT=production
AUTH_MODE=kong
# Require CUDA for the Dokploy GPU deployment.
CAR_DAMAGE_REQUIRE_CUDA=false
# Control plane base URL. Over plain http in production this MUST be a
# Tailscale peer (100.64.0.0/10) OR the loopback-only internal listener
# (127.0.0.1:18083). The colocated control-plane path uses the dedicated
# loopback nginx listener that exposes only the required internal endpoints; it
# does not add an allow 127.0.0.1 rule to the Tailscale control-plane listener.
CONTROL_PLANE_BASE_URL=http://127.0.0.1:18083
# Service credential issued by `seed_car_damage --create-credential`.
# Required in production control-plane mode; 32-512 ASCII chars.
SERVICE_CREDENTIAL=
CONTROL_PLANE_INTROSPECT_TIMEOUT_SECONDS=2

# Positive auth cache. TTL is min(local, control-plane cache_ttl_seconds,
# remaining key expiry) and never exceeds 30s so a revoked key stops working
# within ~30s.
AUTH_CACHE_MAX_TTL_SECONDS=30
AUTH_CACHE_MAX_ENTRIES=4096

# Async usage reporting to the control plane.
USAGE_FLUSH_INTERVAL_SECONDS=10
USAGE_RETRY_ATTEMPTS=3
USAGE_MAX_QUEUE_BATCHES=1000
USAGE_MAX_RECORDS_PER_BATCH=500
USAGE_MAX_QUEUED_RECORDS=100000

# Per-key assess rate-limit enforcement (category `assess`, fixed 60s window).
# Kill switch: absent or `false` keeps the old behavior (authentication and
# usage still run; policy parsing still happens, so a malformed policy fails
# closed with 503). Explicit `true` enables enforcement. Counters are
# in-memory and single-process: a restart resets them, N workers multiply the
# effective limit N-fold, so the loopback-only Redis backend (127.0.0.1:6379)
# must be enabled before scaling to multi-worker or multi-instance.
API_KEY_RATE_LIMIT_ENFORCEMENT=true

# Host validation. Production requires explicit hosts; wildcard is forbidden.
# Include the exact Host header value used to reach this API.
ALLOWED_HOSTS=car-damage-api.fanfanfw.biz.id,100.124.216.27
# Browser CORS is disabled by default (console.html is not used in
# production). Only set explicit origins if a browser client needs the API.
CORS_ALLOWED_ORIGINS=
# Docs (/docs, /redoc, /openapi.json) stay public by decision of the operator.
API_DOCS_ENABLED=true
# Only peers listed here are trusted for X-Forwarded-* headers. Must be an
# exact loopback peer in production.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Upload hardening.
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_PIXELS=24000000
MAX_IMAGE_DIMENSION=12000
# Upper bound on concurrent model inferences (memory/GPU protection).
MAX_CONCURRENT_ASSESSMENTS=4

# Development-only synthetic fallback. MUST be false (or unset) in production;
# load_settings refuses a production config with this enabled. Production
# model/decision failures return 503, never a demo HTTP 200.
DEMO_FALLBACK_ENABLED=false
